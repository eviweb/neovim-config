_mise_missing_deps() {
  local -n _mise_missing_deps_out="$1"
  _mise_missing_deps_out=()
  command -v curl > /dev/null 2>&1 || _mise_missing_deps_out+=(curl)
  command -v gpg > /dev/null 2>&1 || _mise_missing_deps_out+=(gnupg)
}

run_install_mise() {
  if command -v mise > /dev/null 2>&1; then
    log_message "INFO" "mise is already installed — skipping"
    return 0
  fi

  local missing=()
  _mise_missing_deps missing
  if [ "${#missing[@]}" -gt 0 ]; then
    log_message "ERROR" "mise install requires: ${missing[*]} — install with 'sudo apt install ${missing[*]}' first"
    return 1
  fi

  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "gpg --keyserver hkps://keys.openpgp.org --recv-keys ${MISE_GPG_KEY_FINGERPRINT}"
    log_message "INFO" "curl -sSfL https://mise.jdx.dev/install.sh.sig | gpg --decrypt > install.sh && sh install.sh"
    return 0
  fi

  local tmp_dir status=0
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "${tmp_dir}"' EXIT INT TERM

  log_message "INFO" "Importing mise release GPG key (${MISE_GPG_KEY_FINGERPRINT})"
  if ! gpg --keyserver hkps://keys.openpgp.org --recv-keys "${MISE_GPG_KEY_FINGERPRINT}"; then
    log_message "ERROR" "Failed to import the mise release GPG key"
    status=1
  fi

  if [ "${status}" -eq 0 ]; then
    log_message "INFO" "Downloading and verifying the mise installer"
    if ! curl -sSfL https://mise.jdx.dev/install.sh.sig | gpg --decrypt > "${tmp_dir}/install.sh" 2>/dev/null; then
      log_message "ERROR" "mise installer GPG signature verification failed"
      status=1
    elif [ ! -s "${tmp_dir}/install.sh" ]; then
      log_message "ERROR" "mise installer verification produced an empty script"
      status=1
    fi
  fi

  if [ "${status}" -eq 0 ]; then
    run_command sh "${tmp_dir}/install.sh" || status=$?
  fi

  # The installer just placed the binary at ~/.local/bin/mise, but that
  # directory is not necessarily on this process's PATH yet (it usually
  # only gets added by a login shell's rc file) — without this, the very
  # next `mise use -g ...` call in the same run fails with "not found",
  # even though the install itself succeeded.
  if [ "${status}" -eq 0 ] && ! command -v mise > /dev/null 2>&1; then
    case ":${PATH}:" in
      *":${HOME}/.local/bin:"*) ;;
      *) export PATH="${HOME}/.local/bin:${PATH}" ;;
    esac
    if ! command -v mise > /dev/null 2>&1; then
      log_message "ERROR" "mise was installed but is not on PATH (expected ${HOME}/.local/bin/mise) — reload your shell and retry"
      status=1
    fi
  fi

  # Local vars like tmp_dir go out of scope on return, but EXIT/INT/TERM traps
  # are process-global and would otherwise keep referencing it after this
  # function returns, crashing later (with set -u) when the trap finally fires.
  rm -rf "${tmp_dir}"
  trap - EXIT INT TERM

  if [ "${status}" -eq 0 ]; then
    _offer_mise_activation "$(command -v mise)"
  fi

  return "${status}"
}

_mise_shell_rc_file() {
  case "$(basename "${SHELL:-bash}")" in
    zsh)  printf '%s' "${ZDOTDIR:-$HOME}/.zshrc" ;;
    fish) printf '%s' "${HOME}/.config/fish/config.fish" ;;
    *)    printf '%s' "${HOME}/.bashrc" ;;
  esac
}

# Uses the absolute path to the mise binary (matching what mise's own
# installer recommends), not bare `mise` — a shell rc line that calls plain
# `mise activate bash` needs `mise` to already be resolvable via PATH just
# to run that command, but PATH is exactly what activation is supposed to
# fix. The absolute path sidesteps that chicken-and-egg problem.
# shellcheck disable=SC2016  # %s substitutes now; $(...) stays literal for the shell to expand later
_mise_activate_line() {
  local mise_bin="$1"
  case "$(basename "${SHELL:-bash}")" in
    zsh)  printf 'eval "$(%s activate zsh)"' "${mise_bin}" ;;
    fish) printf '%s activate fish | source' "${mise_bin}" ;;
    *)    printf 'eval "$(%s activate bash)"' "${mise_bin}" ;;
  esac
}

# Defense in depth alongside the absolute-path activate line: guarantee
# ~/.local/bin is on PATH too, independent of whatever mise's own activate
# script does or doesn't add. Written so it's safe to source every time the
# shell starts, not just once — checks PATH at runtime before adding, so
# re-sourcing the rc file repeatedly never accumulates duplicate entries.
# shellcheck disable=SC2016  # $PATH stays literal for the shell to expand later
_mise_path_guard_line() {
  case "$(basename "${SHELL:-bash}")" in
    fish) printf 'fish_add_path %s/.local/bin' "${HOME}" ;;  # built-in, dedupes automatically
    *)    printf 'case ":$PATH:" in *":%s/.local/bin:"*) ;; *) export PATH="%s/.local/bin:$PATH" ;; esac' "${HOME}" "${HOME}" ;;
  esac
}

# mise needs to be activated in the shell rc for itself and any
# globally-set tool (e.g. `mise use -g neovim@latest`) to be found on
# PATH — see https://mise.jdx.dev/installing-mise.html#shell-specific-installation-activation
_offer_mise_activation() {
  local mise_bin="$1"
  local rc_file activate_line path_guard_line
  rc_file="$(_mise_shell_rc_file)"
  activate_line="$(_mise_activate_line "${mise_bin}")"
  path_guard_line="$(_mise_path_guard_line)"

  if [ -f "${rc_file}" ] && grep -qF "mise activate" "${rc_file}" 2>/dev/null; then
    return 0
  fi

  local do_add=0
  case "${ACTIVATE_MODE}" in
    no)
      log_message "INFO" "mise not activated (--no-activate) — add manually: echo '${path_guard_line}' >> ${rc_file} && echo '${activate_line}' >> ${rc_file}, then reload your shell"
      return 0
      ;;
    yes)
      do_add=1
      ;;
    *)
      if _confirm "mise needs to be activated in ${rc_file} for mise-managed tools (like nvim) to be found on PATH. Add it now? [y/N] "; then
        do_add=1
      fi
      ;;
  esac

  if [ "${do_add}" -eq 0 ]; then
    log_message "WARN" "mise not activated — add manually: echo '${path_guard_line}' >> ${rc_file} && echo '${activate_line}' >> ${rc_file}, then reload your shell"
    return 0
  fi

  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "echo '${path_guard_line}' >> ${rc_file}"
    log_message "INFO" "echo '${activate_line}' >> ${rc_file}"
    return 0
  fi

  {
    printf '\n# Added by nvim-config install mise\n'
    printf '%s\n' "${path_guard_line}"
    printf '%s\n' "${activate_line}"
  } >> "${rc_file}"

  MISE_ACTIVATION_PENDING=1
  log_message "INFO" "Added mise activation to ${rc_file} — reload your shell to use it: 'source ${rc_file}' (or open a new terminal)"
}

# Called at the end of any `install` subcommand that may have triggered
# _offer_mise_activation, so the reminder survives past a wall of
# `install deps`/apt output instead of getting buried mid-run.
_maybe_remind_mise_activation() {
  if [ "${MISE_ACTIVATION_PENDING}" -eq 1 ]; then
    log_message "INFO" "Reminder: reload your shell to finish setting up mise — 'source $(_mise_shell_rc_file)' (or open a new terminal)"
  fi
}

_confirm() {
  local prompt="$1"
  if [ "${DRY_RUN}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ ! -t 0 ]; then
    return 1
  fi
  local reply
  read -r -p "${prompt}" reply
  [[ "${reply}" =~ ^[Yy]$ ]]
}

_install_nvim_via() {
  local pkg_manager="$1"
  case "${pkg_manager}" in
    mise)
      # NOTE: this whole function tree runs with `set -e` suppressed — it is
      # always called as `run_install_nvim || ...` from `install all`, and in
      # bash that disables errexit for the entire call subtree, not just the
      # top-level exit code. Every fallible step below MUST be explicitly
      # guarded (`||`/`&&`); a bare failing statement will NOT abort here.
      if ! command -v mise > /dev/null 2>&1; then
        log_message "INFO" "mise is not installed — installing it now (--mise was explicitly requested)"
        local mise_missing=()
        _mise_missing_deps mise_missing
        if [ "${#mise_missing[@]}" -gt 0 ]; then
          log_message "INFO" "installing missing mise prerequisites: ${mise_missing[*]}"
          run_command sudo apt update || return 1
          run_command sudo apt install -y "${mise_missing[@]}" || return 1
        fi
        run_install_mise || return 1
      fi
      run_command mise use -g neovim@latest
      ;;
    snap)
      if ! command -v snap > /dev/null 2>&1; then
        log_message "INFO" "snap is not installed — installing snapd now (--snap was explicitly requested)"
        run_command sudo apt update || return 1
        run_command sudo apt install -y snapd || return 1
      fi
      run_command sudo snap install nvim --classic
      ;;
    apt)
      command -v apt > /dev/null 2>&1 || { log_message "ERROR" "apt is required but was not found on this system"; return 1; }
      run_command sudo apt update || return 1
      run_command sudo apt install -y neovim
      ;;
  esac
}

_install_nvim_auto() {
  if command -v mise > /dev/null 2>&1; then
    run_command mise use -g neovim@latest
    return 0
  fi

  local mise_missing=()
  _mise_missing_deps mise_missing
  local mise_prompt="mise is not installed. Install it now via the GPG-verified installer? [y/N] "
  if [ "${#mise_missing[@]}" -gt 0 ]; then
    mise_prompt="mise is not installed and requires: ${mise_missing[*]}. Install ${mise_missing[*]} + mise now? [y/N] "
  fi

  if _confirm "${mise_prompt}"; then
    local prereqs_ok=1
    if [ "${#mise_missing[@]}" -gt 0 ]; then
      if ! { run_command sudo apt update && run_command sudo apt install -y "${mise_missing[@]}"; }; then
        prereqs_ok=0
      fi
    fi
    if [ "${prereqs_ok}" -eq 1 ] && run_install_mise; then
      run_command mise use -g neovim@latest
      return 0
    fi
    log_message "WARN" "mise installation failed — falling back to snap/apt"
  fi

  if command -v snap > /dev/null 2>&1; then
    run_command sudo snap install nvim --classic
    return 0
  fi

  if _confirm "snap is not installed. Install snapd now (sudo apt install snapd)? [y/N] "; then
    if run_command sudo apt update && run_command sudo apt install -y snapd \
      && run_command sudo snap install nvim --classic; then
      return 0
    fi
    log_message "WARN" "snapd installation failed — falling back to apt"
  fi

  command -v apt > /dev/null 2>&1 || { log_message "ERROR" "apt is required but was not found on this system"; return 1; }
  run_command sudo apt update || return 1
  run_command sudo apt install -y neovim
}

run_install_nvim() {
  if command -v nvim > /dev/null 2>&1; then
    log_message "INFO" "nvim is already installed — skipping (use 'update nvim' to upgrade)"
    return 0
  fi

  if [ "${NVIM_PKG_MANAGER}" != "auto" ]; then
    _install_nvim_via "${NVIM_PKG_MANAGER}"
    return
  fi

  _install_nvim_auto
}

run_update_nvim() {
  if ! command -v nvim > /dev/null 2>&1; then
    log_message "ERROR" "nvim is not installed — run 'install nvim' first"
    return 1
  fi

  if command -v mise > /dev/null 2>&1 && mise which nvim > /dev/null 2>&1; then
    run_command mise use -g neovim@latest
  elif snap list nvim > /dev/null 2>&1; then
    run_command sudo snap refresh nvim
  else
    run_command sudo apt install -y --only-upgrade neovim
  fi
}

run_update_plugins() {
  if ! command -v nvim > /dev/null 2>&1; then
    log_message "ERROR" "nvim is not installed — run 'install nvim' first"
    return 1
  fi
  run_command nvim --headless -u "${PROJECT_DIR}/init.lua" +"Lazy! sync" +qa
}

run_update_dap_adapters() {
  local profile; profile="$(_read_active_profile)"
  if [ -z "${profile}" ]; then
    log_message "INFO" "No active profile — nothing to update"
    return 0
  fi
  local lua_file="${PROJECT_DIR}/lua/profiles/${profile}.lua"
  if [ ! -f "${lua_file}" ]; then
    log_message "ERROR" "Profile file not found: ${lua_file}"
    return 1
  fi
  local pkgs
  pkgs="$(_extract_lua_list "${lua_file}" "dap_mason_packages" 2>/dev/null || true)"
  if [ -z "${pkgs}" ]; then
    log_message "INFO" "No DAP packages declared for profile '${profile}'"
    return 0
  fi
  log_message "INFO" "DAP packages for profile '${profile}':"
  while IFS= read -r pkg; do
    [ -n "${pkg}" ] && log_message "INFO" "  ${pkg}"
  done <<< "${pkgs}"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "nvim --headless: MasonInstall (packages listed above)"
    return 0
  fi
  local mason_cmds=()
  while IFS= read -r pkg; do
    [ -n "${pkg}" ] && mason_cmds+=("+MasonInstall ${pkg}")
  done <<< "${pkgs}"
  log_message "INFO" "Installing DAP adapters via Mason (this may take a moment)..."
  # shellcheck disable=SC2068
  nvim --headless -u "${PROJECT_DIR}/init.lua" ${mason_cmds[@]} +qa 2>/dev/null || true
  log_message "INFO" "Done — verify inside Neovim with :Mason"
}

run_update_tree_sitter() {
  local vendor_dir="${PROJECT_DIR}/vendor/tree-sitter"
  local binary="${vendor_dir}/tree-sitter"
  local arch; arch="$(uname -m)"

  case "${arch}" in
    x86_64)  local asset="tree-sitter-linux-x64.gz" ;;
    aarch64) local asset="tree-sitter-linux-arm64.gz" ;;
    *)
      log_message "ERROR" "Unsupported architecture: ${arch}"
      return 1
      ;;
  esac

  command -v curl > /dev/null 2>&1 || { log_message "ERROR" "curl is required" >&2; return 1; }

  local latest_tag
  latest_tag="$(curl -sf https://api.github.com/repos/tree-sitter/tree-sitter/releases/latest \
    | grep '"tag_name"' | sed 's/.*"tag_name": "\(.*\)".*/\1/')"
  if [ -z "${latest_tag}" ]; then
    log_message "ERROR" "Could not fetch latest tree-sitter release tag"
    return 1
  fi

  local current_version="none"
  if [ -x "${binary}" ]; then
    current_version="$("${binary}" --version 2>/dev/null | awk '{print $2}')"
  fi
  local latest_version="${latest_tag#v}"

  if [ "${current_version}" = "${latest_version}" ]; then
    log_message "INFO" "tree-sitter is already at ${latest_version} — nothing to do"
    return 0
  fi

  log_message "INFO" "Updating tree-sitter ${current_version} → ${latest_version}"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "  would download: https://github.com/tree-sitter/tree-sitter/releases/download/${latest_tag}/${asset}"
    return 0
  fi

  local url="https://github.com/tree-sitter/tree-sitter/releases/download/${latest_tag}/${asset}"
  run_command mkdir -p "${vendor_dir}"
  curl -sL "${url}" -o "${binary}.gz"
  gunzip -f "${binary}.gz"
  chmod +x "${binary}"
  log_message "INFO" "tree-sitter updated to $("${binary}" --version)"
}

run_update() {
  local subcommand="${1:-all}"
  case "${subcommand}" in
    nvim)
      run_update_nvim
      ;;
    plugins)
      run_update_plugins
      ;;
    dap-adapters)
      run_update_dap_adapters
      ;;
    tree-sitter)
      run_update_tree_sitter
      ;;
    all)
      run_update_nvim
      run_update_plugins
      run_update_tree_sitter
      ;;
    *)
      printf 'Unknown update subcommand: %s\n' "${subcommand}" >&2
      print_usage
      exit 1
      ;;
  esac
}

run_profile_list() {
  local profiles_dir="${PROJECT_DIR}/lua/profiles"
  if [ ! -d "${profiles_dir}" ]; then
    log_message "ERROR" "No profiles directory found at ${profiles_dir}"
    return 1
  fi
  local active; active="$(_read_active_profile)"
  for f in "${profiles_dir}"/*.lua; do
    local name
    name="$(basename "$f" .lua)"
    if [ "${name}" = "init" ] || [ "${name}" = "picker" ]; then
      continue
    fi
    if [ "${name}" = "${active}" ]; then
      log_message "INFO" "* ${name}"
    else
      log_message "INFO" "  ${name}"
    fi
  done
  if [ -z "${active}" ]; then
    log_message "INFO" "(no active profile in current directory)"
  fi
}

run_profile_info() {
  local profile; profile="$(_read_active_profile)"
  if [ -z "${profile}" ]; then
    log_message "INFO" "Active profile: (none)"
    return 0
  fi
  local lua_file="${PROJECT_DIR}/lua/profiles/${profile}.lua"
  log_message "INFO" "Active profile: ${profile}"
  if [ ! -f "${lua_file}" ]; then
    log_message "WARN" "Profile file not found: ${lua_file}"
    return 1
  fi
  local lsp_servers
  lsp_servers="$(_extract_lua_list "${lua_file}" "lsp_servers" 2>/dev/null || true)"
  if [ -n "${lsp_servers}" ]; then
    log_message "INFO" "LSP servers:"
    while IFS= read -r srv; do
      [ -n "${srv}" ] && log_message "INFO" "  ${srv}"
    done <<< "${lsp_servers}"
  fi
  local dap_pkgs
  dap_pkgs="$(_extract_lua_list "${lua_file}" "dap_mason_packages" 2>/dev/null || true)"
  if [ -n "${dap_pkgs}" ]; then
    log_message "INFO" "DAP packages:"
    while IFS= read -r pkg; do
      [ -n "${pkg}" ] && log_message "INFO" "  ${pkg}"
    done <<< "${dap_pkgs}"
  fi
}

run_profile_detect() {
  local detected=()
  if [ -f "package.json" ]; then
    detected+=("web")
  fi
  if [ -f "Cargo.toml" ]; then
    detected+=("rust")
  fi
  if [ -f "composer.json" ]; then
    if grep -q "laravel/framework" composer.json 2>/dev/null; then
      detected+=("laravel")
    else
      detected+=("php")
    fi
  fi
  if [ "${#detected[@]}" -eq 0 ]; then
    log_message "INFO" "No profiles detected — using base"
  else
    log_message "INFO" "Detected profiles: ${detected[*]}"
  fi
}

run_profile_set() {
  local name="${1:?Missing profile name for: profile set}"
  local profile_file="${PWD}/.nvim-profile"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "printf '%s\\n' '${name}' > ${profile_file}"
    return 0
  fi
  printf '%s\n' "${name}" > "${profile_file}"
  log_message "INFO" "Profile '${name}' written to ${profile_file}"
}

run_profile_unset() {
  local profile_file="${PWD}/.nvim-profile"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "rm -f ${profile_file}"
    return 0
  fi
  if [ -f "${profile_file}" ]; then
    rm -f "${profile_file}"
    log_message "INFO" "Removed ${profile_file}"
  else
    log_message "INFO" "${profile_file} does not exist — nothing to do"
  fi
}

run_profile_create() {
  local name="${1:?Missing profile name for: profile create}"
  local profile_file="${PROJECT_DIR}/lua/profiles/${name}.lua"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "Generate profile template: lua/profiles/${name}.lua"
    return 0
  fi
  if [ -f "${profile_file}" ]; then
    log_message "ERROR" "${profile_file} already exists — remove it first"
    return 1
  fi
  cat > "${profile_file}" << LUAEOF
-- lua/profiles/${name}.lua

return {
    name = '${name}',
    extends = {},

    lsp_servers = {},

    plugins = {},

    null_ls_sources = function(null_ls)
        return {}
    end,
}
LUAEOF
  log_message "INFO" "Profile template created: ${profile_file}"
}

run_profile() {
  case "${PROFILE_SUBCOMMAND:-list}" in
    list)
      run_profile_list
      ;;
    detect)
      run_profile_detect
      ;;
    set)
      if [ -z "${PROFILE_NAME}" ]; then
        printf 'Missing profile name for: profile set\n' >&2
        exit 1
      fi
      run_profile_set "${PROFILE_NAME}"
      ;;
    unset)
      run_profile_unset
      ;;
    create)
      if [ -z "${PROFILE_NAME}" ]; then
        printf 'Missing profile name for: profile create\n' >&2
        exit 1
      fi
      run_profile_create "${PROFILE_NAME}"
      ;;
    info)
      run_profile_info
      ;;
    *)
      printf 'Unknown profile subcommand: %s\n' "${PROFILE_SUBCOMMAND}" >&2
      print_usage
      exit 1
      ;;
  esac
}

run_ui_set() {
  local variant="${1:?Missing variant for: ui set (classic|modern)}"
  if [[ "${variant}" != "classic" && "${variant}" != "modern" ]]; then
    printf 'Unknown UI variant: %s. Use classic or modern.\n' "${variant}" >&2
    return 1
  fi
  local ui_file="${PROJECT_DIR}/.nvim-ui"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "printf '%s\\n' '${variant}' > ${ui_file}"
    return 0
  fi
  printf '%s\n' "${variant}" > "${ui_file}"
  log_message "INFO" "UI variant '${variant}' written to ${ui_file}"
}

run_ui_unset() {
  local ui_file="${PROJECT_DIR}/.nvim-ui"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "rm -f ${ui_file}"
    return 0
  fi
  if [ -f "${ui_file}" ]; then
    rm -f "${ui_file}"
    log_message "INFO" "Removed ${ui_file} — reverts to classic"
  else
    log_message "INFO" "${ui_file} does not exist — nothing to do"
  fi
}

run_ui_info() {
  local ui; ui="$(_read_active_ui)"
  log_message "INFO" "Active UI variant: ${ui}"
}

run_ui() {
  case "${UI_SUBCOMMAND:-}" in
    info)
      run_ui_info
      ;;
    set)
      if [ -z "${UI_VARIANT}" ]; then
        printf 'Missing variant for: ui set (classic|modern)\n' >&2
        exit 1
      fi
      run_ui_set "${UI_VARIANT}"
      ;;
    unset)
      run_ui_unset
      ;;
    *)
      printf 'Unknown ui subcommand: %s. Use: info, set, unset\n' "${UI_SUBCOMMAND}" >&2
      print_usage
      exit 1
      ;;
  esac
}

run_theme_set() {
  local name="${1:?Missing theme name for: theme set}"
  local theme_file="${PROJECT_DIR}/.nvim-theme"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "printf '%s\\n' '${name}' > ${theme_file}"
    return 0
  fi
  printf '%s\n' "${name}" > "${theme_file}"
  log_message "INFO" "Theme '${name}' written to ${theme_file}"
}

run_theme_unset() {
  local theme_file="${PROJECT_DIR}/.nvim-theme"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "rm -f ${theme_file}"
    return 0
  fi
  if [ -f "${theme_file}" ]; then
    rm -f "${theme_file}"
    log_message "INFO" "Removed ${theme_file} — reverts to nightfox"
  else
    log_message "INFO" "${theme_file} does not exist — nothing to do"
  fi
}

run_theme_info() {
  local theme; theme="$(_read_active_theme)"
  log_message "INFO" "Active theme: ${theme}"
}

run_theme_list() {
  local active; active="$(_read_active_theme)"
  for theme in "${VALID_THEMES[@]}"; do
    if [ "${theme}" = "${active}" ]; then
      log_message "INFO" "* ${theme}"
    else
      log_message "INFO" "  ${theme}"
    fi
  done
}

run_theme() {
  case "${THEME_SUBCOMMAND:-}" in
    info)
      run_theme_info
      ;;
    list)
      run_theme_list
      ;;
    set)
      if [ -z "${THEME_NAME}" ]; then
        printf 'Missing theme name for: theme set\n' >&2
        exit 1
      fi
      run_theme_set "${THEME_NAME}"
      ;;
    unset)
      run_theme_unset
      ;;
    *)
      printf 'Unknown theme subcommand: %s. Use: info, list, set, unset\n' "${THEME_SUBCOMMAND}" >&2
      print_usage
      exit 1
      ;;
  esac
}

run_install_tmux() {
  local tmux_conf="${HOME}/.tmux.conf"
  local source_line="source-file ${PROJECT_DIR}/.tmux.conf"

  if [ -f "${tmux_conf}" ] && grep -qF "${source_line}" "${tmux_conf}"; then
    log_message "INFO" "${tmux_conf} already sources ${PROJECT_DIR}/.tmux.conf — skipping"
    return 0
  fi

  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "printf '\\n%s\\n' '${source_line}' >> ${tmux_conf}"
    return 0
  fi

  printf '\n%s\n' "${source_line}" >> "${tmux_conf}"
  log_message "INFO" "Added source-file entry to ${tmux_conf}"
}

run_install_node() {
  if [ -d "${NVM_DIR}" ]; then
    log_message "INFO" "nvm already installed at ${NVM_DIR} — skipping nvm install"
  else
    run_command bash -c "curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v${NVM_VERSION}/install.sh | bash"
  fi
  run_command bash -c ". ${NVM_DIR}/nvm.sh && nvm install --lts"
}

run_install_deps() {
  if [ -n "${TERMUX_VERSION:-}" ]; then
    run_command pkg update || return 1
    run_command pkg install curl ripgrep fd git make nodejs npm
  else
    run_command sudo apt update || return 1
    run_command sudo apt install -y git make gcc curl ripgrep fd-find xsel xclip wl-clipboard lolcat gnupg
    if [ "${WITH_NODE}" -eq 1 ]; then
      run_install_node
    fi
  fi
}

run_install_config() {
  local nvim_config_dir="${HOME}/.config/nvim"

  if [ -L "${nvim_config_dir}" ]; then
    local current_target
    current_target="$(readlink -f "${nvim_config_dir}")"
    if [ "${current_target}" = "${PROJECT_DIR}" ]; then
      log_message "INFO" "${nvim_config_dir} is already linked to ${PROJECT_DIR}"
      return 0
    fi
    log_message "ERROR" "${nvim_config_dir} is a symlink to ${current_target}, not ${PROJECT_DIR} — remove it manually first"
    return 1
  fi

  if [ -e "${nvim_config_dir}" ]; then
    log_message "ERROR" "${nvim_config_dir} exists and is not a symlink — remove it manually first"
    return 1
  fi

  run_command mkdir -p "${HOME}/.config"
  run_command ln -s "${PROJECT_DIR}" "${nvim_config_dir}"
  log_message "INFO" "Linked ${nvim_config_dir} → ${PROJECT_DIR}"
}

run_uninstall_config() {
  local nvim_config_dir="${HOME}/.config/nvim"

  if [ ! -e "${nvim_config_dir}" ] && [ ! -L "${nvim_config_dir}" ]; then
    log_message "INFO" "${nvim_config_dir} does not exist — nothing to uninstall"
    return 0
  fi

  if [ ! -L "${nvim_config_dir}" ]; then
    log_message "ERROR" "${nvim_config_dir} exists and is not a symlink — remove it manually if you're sure"
    return 1
  fi

  local current_target
  current_target="$(readlink -f "${nvim_config_dir}")"
  if [ "${current_target}" != "${PROJECT_DIR}" ]; then
    log_message "ERROR" "${nvim_config_dir} is a symlink to ${current_target}, not ${PROJECT_DIR} — leaving it untouched"
    return 1
  fi

  run_command rm "${nvim_config_dir}"
  log_message "INFO" "Removed ${nvim_config_dir}"
}

# apt packages installed by 'install deps' (git, make, gcc, curl, ripgrep,
# fd-find, xsel, xclip, wl-clipboard, lolcat, gnupg) are shared system
# dependencies — other tools on the machine may rely on them too. Removing
# them automatically risks breaking something unrelated to this config, so
# this only ever prints the manual command; it never runs apt remove itself.
run_uninstall_deps() {
  log_message "INFO" "nvim-config never removes apt packages automatically — they may be required by other tools on this system."
  log_message "INFO" "Packages installed by 'install deps': git make gcc curl ripgrep fd-find xsel xclip wl-clipboard lolcat gnupg"
  log_message "INFO" "Remove manually if you're sure none of them are needed elsewhere: sudo apt remove git make gcc curl ripgrep fd-find xsel xclip wl-clipboard lolcat gnupg"
}

run_uninstall_nvim() {
  if ! command -v nvim > /dev/null 2>&1; then
    log_message "INFO" "nvim is not installed — nothing to uninstall"
    return 0
  fi

  if command -v mise > /dev/null 2>&1 && mise which nvim > /dev/null 2>&1; then
    if ! _confirm "Remove Neovim installed via mise (mise unuse -g neovim + mise uninstall)? [y/N] "; then
      log_message "INFO" "Skipped — nvim left installed"
      return 0
    fi
    local nvim_version
    nvim_version="$(mise current neovim 2>/dev/null | awk '{print $1}')"
    run_command mise unuse -g neovim
    if [ -n "${nvim_version}" ] && [ "${nvim_version}" != "none" ]; then
      run_command mise uninstall "neovim@${nvim_version}"
    else
      log_message "WARN" "Could not determine the installed neovim version — run 'mise uninstall neovim@<version>' manually if needed"
    fi
  elif snap list nvim > /dev/null 2>&1; then
    if ! _confirm "Remove Neovim installed via snap (sudo snap remove nvim)? [y/N] "; then
      log_message "INFO" "Skipped — nvim left installed"
      return 0
    fi
    run_command sudo snap remove nvim
  else
    if ! _confirm "Remove Neovim installed via apt (sudo apt remove neovim)? [y/N] "; then
      log_message "INFO" "Skipped — nvim left installed"
      return 0
    fi
    run_command sudo apt remove -y neovim
  fi
}

# Reverses _offer_mise_activation: strips the exact block it appended
# (marker comment + the 2 lines that follow it), identified by the same
# marker comment. Kept as its own function, independent of the _confirm
# gate in run_uninstall_mise, so the rc-file cleanup can be exercised on
# its own.
_remove_mise_activation() {
  local rc_file
  rc_file="$(_mise_shell_rc_file)"

  if [ ! -f "${rc_file}" ] || ! grep -qF "# Added by nvim-config install mise" "${rc_file}" 2>/dev/null; then
    return 0
  fi

  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "Remove the activation block added by 'install mise' from ${rc_file}"
    return 0
  fi

  local tmp_rc
  tmp_rc="$(mktemp)"
  awk '
    skip > 0 { skip--; next }
    $0 == "# Added by nvim-config install mise" { skip = 2; next }
    { print }
  ' "${rc_file}" > "${tmp_rc}"
  mv "${tmp_rc}" "${rc_file}"
  log_message "INFO" "Removed mise activation lines from ${rc_file}"
}

run_uninstall_mise() {
  if ! command -v mise > /dev/null 2>&1; then
    log_message "INFO" "mise is not installed — nothing to uninstall"
    return 0
  fi

  if ! _confirm "Remove the mise binary and its shell activation lines added by 'install mise'? [y/N] "; then
    log_message "INFO" "Skipped — mise left installed"
    return 0
  fi

  local mise_bin
  mise_bin="$(command -v mise)"
  run_command rm -f "${mise_bin}"
  _remove_mise_activation

  log_message "INFO" "mise binary removed — any tools it managed (e.g. under ~/.config/mise) are left untouched"
}

run_uninstall() {
  local subcommand="${1:-all}"
  case "${subcommand}" in
    config)
      run_uninstall_config
      ;;
    nvim)
      run_uninstall_nvim
      ;;
    mise)
      run_uninstall_mise
      ;;
    deps)
      run_uninstall_deps
      ;;
    all)
      local had_error=0
      run_uninstall_config || had_error=1
      run_uninstall_nvim || had_error=1
      run_uninstall_mise || had_error=1
      run_uninstall_deps
      return "${had_error}"
      ;;
    *)
      printf 'Unknown uninstall subcommand: %s\n' "${subcommand}" >&2
      print_usage
      exit 1
      ;;
  esac
}

run_install() {
  local subcommand="${1:-all}"
  case "${subcommand}" in
    deps)
      run_install_deps
      ;;
    config)
      run_install_config
      ;;
    tmux)
      run_install_tmux
      ;;
    nvim)
      run_install_nvim
      _maybe_remind_mise_activation
      ;;
    mise)
      run_install_mise
      _maybe_remind_mise_activation
      ;;
    claude)
      run_install_claude
      ;;
    codex)
      run_install_codex
      ;;
    gemini)
      run_install_gemini
      ;;
    all)
      local had_error=0
      run_install_nvim || { log_message "WARN" "nvim install failed — continuing with deps and config"; had_error=1; }
      run_install_deps || had_error=1
      run_install_config || had_error=1
      # After deps (curl is guaranteed present by then) — nvim-treesitter shells
      # out to a bare `tree-sitter` command with no configurable path, so the
      # CLI needs to exist before the first parser install attempt at VimEnter.
      run_update_tree_sitter || had_error=1
      _maybe_remind_mise_activation
      return "${had_error}"
      ;;
    *)
      printf 'Unknown install subcommand: %s\n' "${subcommand}" >&2
      print_usage
      exit 1
      ;;
  esac
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      print_usage
      exit 0
      ;;
    -V|--version)
      read_version
      exit 0
      ;;
    -v|--verbose)
      VERBOSE=1
      shift
      ;;
    -q|--quiet)
      QUIET=1
      shift
      ;;
    --debug)
      DEBUG=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --no-color)
      NO_COLOR=1
      shift
      ;;
    --no-log)
      NO_LOG=1
      shift
      ;;
    --with-node)
      WITH_NODE=1
      shift
      ;;
    --activate)
      ACTIVATE_MODE="yes"
      shift
      ;;
    --no-activate)
      ACTIVATE_MODE="no"
      shift
      ;;
    --snap)
      NVIM_PKG_MANAGER="snap"
      shift
      ;;
    --apt)
      NVIM_PKG_MANAGER="apt"
      shift
      ;;
    --mise)
      NVIM_PKG_MANAGER="mise"
      shift
      ;;
    --log-dir)
      LOG_DIR="${2:?Missing value for --log-dir}"
      shift 2
      ;;
    --show-completion)
      COMPLETION_SHELL="${2:?Missing shell name for --show-completion}"
      COMMAND="show-completion"
      shift 2
      ;;
    --install-completion)
      COMPLETION_SHELL="${2:?Missing shell name for --install-completion}"
      COMMAND="install-completion"
      shift 2
      ;;
    install)
      COMMAND="install"
      shift
      if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
        SUBCOMMAND="$1"
        shift
      fi
      ;;
    uninstall)
      COMMAND="uninstall"
      shift
      if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
        SUBCOMMAND="$1"
        shift
      fi
      ;;
    update)
      COMMAND="update"
      shift
      if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
        SUBCOMMAND="$1"
        shift
      fi
      ;;
    profile)
      COMMAND="profile"
      shift
      if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
        PROFILE_SUBCOMMAND="$1"
        shift
        if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
          PROFILE_NAME="$1"
          shift
        fi
      fi
      ;;
    ui)
      COMMAND="ui"
      shift
      if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
        UI_SUBCOMMAND="$1"
        shift
        if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
          UI_VARIANT="$1"
          shift
        fi
      fi
      ;;
    theme)
      COMMAND="theme"
      shift
      if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
        THEME_SUBCOMMAND="$1"
        shift
        if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
          THEME_NAME="$1"
          shift
        fi
      fi
      ;;
    status)
      COMMAND="status"
      shift
      ;;
    doctor)
      COMMAND="doctor"
      shift
      ;;
    keymaps)
      COMMAND="keymaps"
      shift
      ;;
    *)
      printf 'Unknown argument: %s\n' "$1" >&2
      exit 1
      ;;
  esac
done

if [ "${DEBUG}" -eq 1 ]; then
  set -x
fi

setup_logging

case "${COMMAND}" in
  show-completion)
    show_completion "${COMPLETION_SHELL}"
    ;;
  install-completion)
    install_completion "${COMPLETION_SHELL}"
    ;;
  install)
    run_install "${SUBCOMMAND}"
    ;;
  uninstall)
    run_uninstall "${SUBCOMMAND}"
    ;;
  update)
    run_update "${SUBCOMMAND}"
    ;;
  profile)
    run_profile
    ;;
  ui)
    run_ui
    ;;
  theme)
    run_theme
    ;;
  status)
    run_status
    ;;
  doctor)
    run_doctor
    ;;
  keymaps)
    run_keymaps
    ;;
  *)
    print_usage
    exit 1
    ;;
esac
