#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
SCRIPT_NAME="nvim-config"
VERSION_FILE="${PROJECT_DIR}/VERSION"

QUIET=0
VERBOSE=0
DRY_RUN=0
DEBUG=0
PROFILE_SUBCOMMAND=""
PROFILE_NAME=""
UI_SUBCOMMAND=""
UI_VARIANT=""
THEME_SUBCOMMAND=""
THEME_NAME=""
# Respect NO_COLOR env var (https://no-color.org)
if [[ -n "${NO_COLOR:-}" ]]; then
  NO_COLOR=1
else
  NO_COLOR=0
fi
NO_LOG=0
WITH_NODE=0
NVIM_PKG_MANAGER="snap"
COMMAND=""
SUBCOMMAND=""
COMPLETION_SHELL=""

NVM_VERSION="0.39.7"
NVM_DIR="${HOME}/.nvm"

LOG_DIR_DEFAULT="${NVIM_CONFIG_LOG_DIR:-${HOME}/.local/state/${SCRIPT_NAME}/logs}"
LOG_DIR="${LOG_DIR_DEFAULT}"
LOG_FILE=""

print_usage() {
  cat <<'EOF'
Usage:
  nvim-config [global-options] <command> [subcommand]
  nvim-config [global-options] --show-completion bash
  nvim-config [global-options] --install-completion bash

Commands:
  install [deps|config|all|tmux|nvim|claude|codex] [--with-node] [--snap|--apt]
                        Install system dependencies and/or config symlinks
                          deps   — install apt packages only
                          config — symlink ~/.config/nvim to this repository
                          tmux   — inject source-file entry into ~/.tmux.conf
                          nvim   — install Neovim (snap by default)
                          claude — install Claude Code CLI (requires Node.js)
                          codex  — install OpenAI Codex CLI (requires Node.js)
                          all    — nvim, deps, then config
                        --with-node
                               Also install nvm and Node.js LTS (opt-in).
                               Skipped if nvm is already present at ~/.nvm.
                        --snap  Install Neovim via snap (default for install nvim)
                        --apt   Install Neovim via apt instead of snap

  update [nvim|plugins|all]
                        Update Neovim and/or plugins
                          nvim    — refresh Neovim (snap or apt, auto-detected)
                          plugins — run Lazy! sync headlessly
                          all     — nvim then plugins (default)

  profile [list|detect|set|unset|create] [<name>]
                        Manage per-project Neovim profiles
                          list   — list available profiles
                          detect — detect profiles for the current directory
                          set    — write .nvim-profile in the current directory
                          unset  — remove .nvim-profile from the current directory
                          create — generate a new profile template in lua/profiles/

  ui [set|unset] [classic|modern]
                        Manage the active UI variant
                          set    — write .nvim-ui at the config root
                          unset  — remove .nvim-ui (reverts to classic)

  theme [set|unset] [<name>]
                        Manage the active colorscheme
                          set    — write .nvim-theme at the config root
                          unset  — remove .nvim-theme (reverts to nightfox)

Global options:
  -h, --help            Display usage and exit
  -V, --version         Display version and exit
  -v, --verbose         Enable debug-level output
  -q, --quiet           Suppress terminal output
      --debug           Enable shell trace mode
      --dry-run         Simulate execution without making any changes
      --no-color        Disable colored output
      --no-log          Disable file logging
      --log-dir <path>  Override the log directory
      --show-completion bash|zsh|fish
                        Print the completion script for the given shell
      --install-completion bash|zsh|fish
                        Install completion for the given shell
EOF
}

read_version() {
  tr -d '\n' < "${VERSION_FILE}"
}

setup_logging() {
  if [ "${NO_LOG}" -eq 0 ]; then
    mkdir -p "${LOG_DIR}"
    LOG_FILE="${LOG_DIR}/${SCRIPT_NAME}-$(date +%F).log"
    : > "${LOG_FILE}"
  fi
}

_color_for_level() {
  case "$1" in
    INFO)  printf '\033[0;37m' ;;
    WARN)  printf '\033[0;33m' ;;
    ERROR) printf '\033[0;31m' ;;
    DEBUG) printf '\033[0;36m' ;;
  esac
}

log_message() {
  local level="$1"
  shift
  local message="$*"
  local timestamp
  timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
  local plain_line="[${timestamp}] [${level}] ${message}"

  if [ "${QUIET}" -eq 0 ]; then
    if [ "${NO_COLOR}" -eq 0 ] && [ -t 1 ]; then
      printf '%s%s\033[0m\n' "$(_color_for_level "${level}")" "${plain_line}"
    else
      printf '%s\n' "${plain_line}"
    fi
  fi

  if [ "${level}" = "ERROR" ]; then
    printf '%s\n' "${plain_line}" >&2
  fi

  if [ -n "${LOG_FILE}" ]; then
    printf '%s\n' "${plain_line}" >> "${LOG_FILE}"
  fi
}

run_command() {
  local command_text="$*"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "${command_text}"
    return 0
  fi

  log_message "INFO" "${command_text}"
  "$@"
}

_show_completion_bash() {
  cat <<'EOF'
_nvim_config_completions() {
  local current_word previous_word
  current_word="${COMP_WORDS[COMP_CWORD]}"
  previous_word="${COMP_WORDS[COMP_CWORD-1]}"

  case "${previous_word}" in
    --show-completion|--install-completion)
      COMPREPLY=( $(compgen -W "bash zsh fish" -- "${current_word}") )
      return 0
      ;;
    install|deps|config|all|tmux|nvim|claude|codex)
      COMPREPLY=( $(compgen -W "deps config all tmux nvim claude codex --with-node --snap --apt" -- "${current_word}") )
      return 0
      ;;
    update|plugins)
      COMPREPLY=( $(compgen -W "nvim plugins all" -- "${current_word}") )
      return 0
      ;;
    profile|list|detect|set|unset|create)
      COMPREPLY=( $(compgen -W "list detect set unset create" -- "${current_word}") )
      return 0
      ;;
    ui)
      COMPREPLY=( $(compgen -W "set unset" -- "${current_word}") )
      return 0
      ;;
    classic|modern)
      COMPREPLY=()
      return 0
      ;;
    theme)
      COMPREPLY=( $(compgen -W "set unset" -- "${current_word}") )
      return 0
      ;;
  esac

  if [ "${COMP_CWORD}" -eq 1 ]; then
    COMPREPLY=( $(compgen -W "--help --version --verbose --quiet --debug --dry-run --no-color --no-log --log-dir --show-completion --install-completion install update profile ui theme" -- "${current_word}") )
    return 0
  fi

  COMPREPLY=()
}

complete -F _nvim_config_completions nvim-config
EOF
}

_show_completion_zsh() {
  cat <<'EOF'
#compdef nvim-config

_nvim_config() {
  local -a commands global_opts install_subcmds

  global_opts=(
    '--help[Display usage and exit]'
    '--version[Display version and exit]'
    '--verbose[Enable debug-level output]'
    '--quiet[Suppress terminal output]'
    '--debug[Enable shell trace mode]'
    '--dry-run[Simulate execution without making changes]'
    '--no-color[Disable colored output]'
    '--no-log[Disable file logging]'
    '--log-dir[Override the log directory]:directory:_directories'
    '--show-completion[Print the completion script]:shell:(bash zsh fish)'
    '--install-completion[Install completion for the current user]:shell:(bash zsh fish)'
  )

  commands=(
    'install:Install system dependencies and/or config symlinks'
    'update:Update Neovim and/or plugins'
  )

  install_subcmds=(
    'deps:Install apt packages only'
    'config:Symlink ~/.config/nvim to this repository'
    'all:Install nvim, deps, then config'
    'tmux:Inject source-file entry into ~/.tmux.conf'
    'nvim:Install Neovim (snap by default)'
    'claude:Install Claude Code CLI (requires Node.js)'
    'codex:Install OpenAI Codex CLI (requires Node.js)'
    '--with-node[Also install nvm and Node.js LTS]'
    '--snap[Install Neovim via snap (default)]'
    '--apt[Install Neovim via apt]'
  )

  update_subcmds=(
    'nvim:Refresh Neovim (snap or apt, auto-detected)'
    'plugins:Run Lazy! sync headlessly'
    'all:Update nvim then plugins (default)'
  )

  profile_subcmds=(
    'list:List available profiles'
    'detect:Detect profiles for the current directory'
    'set:Write .nvim-profile in the current directory'
    'unset:Remove .nvim-profile from the current directory'
    'create:Generate a new profile template in lua/profiles/'
  )

  ui_subcmds=(
    'set:Write .nvim-ui at the config root'
    'unset:Remove .nvim-ui (reverts to classic)'
  )

  theme_subcmds=(
    'set:Write .nvim-theme at the config root'
    'unset:Remove .nvim-theme (reverts to nightfox)'
  )

  commands=(
    'install:Install system dependencies and/or config symlinks'
    'update:Update Neovim and/or plugins'
    'profile:Manage per-project Neovim profiles'
    'ui:Manage the active UI variant'
    'theme:Manage the active colorscheme'
  )

  case "${words[2]}" in
    install)
      _arguments : "${install_subcmds[@]}"
      ;;
    update)
      _arguments : "${update_subcmds[@]}"
      ;;
    profile)
      _arguments : "${profile_subcmds[@]}"
      ;;
    ui)
      _arguments : "${ui_subcmds[@]}"
      ;;
    theme)
      _arguments : "${theme_subcmds[@]}"
      ;;
    *)
      _arguments : "${global_opts[@]}" "${commands[@]}"
      ;;
  esac
}

_nvim_config "$@"
EOF
}

_show_completion_fish() {
  cat <<'EOF'
# Fish shell completion for nvim-config

# Disable file completion by default
complete -c nvim-config -f

# Global options
complete -c nvim-config -l help              -d 'Display usage and exit'
complete -c nvim-config -l version           -d 'Display version and exit'
complete -c nvim-config -l verbose           -d 'Enable debug-level output'
complete -c nvim-config -l quiet             -d 'Suppress terminal output'
complete -c nvim-config -l debug             -d 'Enable shell trace mode'
complete -c nvim-config -l dry-run           -d 'Simulate execution without making changes'
complete -c nvim-config -l no-color          -d 'Disable colored output'
complete -c nvim-config -l no-log            -d 'Disable file logging'
complete -c nvim-config -l log-dir           -d 'Override the log directory' -r
complete -c nvim-config -l show-completion   -d 'Print the completion script' -a 'bash zsh fish'
complete -c nvim-config -l install-completion -d 'Install completion for the current user' -a 'bash zsh fish'

# Top-level commands (shown when no subcommand has been typed yet)
complete -c nvim-config -n 'not __fish_seen_subcommand_from install update profile ui theme' \
  -a install -d 'Install system dependencies and/or config symlinks'
complete -c nvim-config -n 'not __fish_seen_subcommand_from install update profile ui theme' \
  -a update  -d 'Update Neovim and/or plugins'
complete -c nvim-config -n 'not __fish_seen_subcommand_from install update profile ui theme' \
  -a profile -d 'Manage per-project Neovim profiles'
complete -c nvim-config -n 'not __fish_seen_subcommand_from install update profile ui theme' \
  -a ui      -d 'Manage the active UI variant'
complete -c nvim-config -n 'not __fish_seen_subcommand_from install update profile ui theme' \
  -a theme   -d 'Manage the active colorscheme'

# install subcommands
complete -c nvim-config -n '__fish_seen_subcommand_from install' -a deps    -d 'Install apt packages only'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -a config  -d 'Symlink ~/.config/nvim to this repository'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -a all     -d 'Install nvim, deps, then config'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -a tmux    -d 'Inject source-file entry into ~/.tmux.conf'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -a nvim    -d 'Install Neovim (snap by default)'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -a claude  -d 'Install Claude Code CLI (requires Node.js)'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -a codex   -d 'Install OpenAI Codex CLI (requires Node.js)'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -l with-node -d 'Also install nvm and Node.js LTS'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -l snap    -d 'Install Neovim via snap (default)'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -l apt     -d 'Install Neovim via apt'

# update subcommands
complete -c nvim-config -n '__fish_seen_subcommand_from update' -a nvim    -d 'Refresh Neovim'
complete -c nvim-config -n '__fish_seen_subcommand_from update' -a plugins -d 'Run Lazy! sync headlessly'
complete -c nvim-config -n '__fish_seen_subcommand_from update' -a all     -d 'Update nvim then plugins (default)'

# profile subcommands
complete -c nvim-config -n '__fish_seen_subcommand_from profile' -a list   -d 'List available profiles'
complete -c nvim-config -n '__fish_seen_subcommand_from profile' -a detect -d 'Detect profiles for the current directory'
complete -c nvim-config -n '__fish_seen_subcommand_from profile' -a set    -d 'Write .nvim-profile in the current directory'
complete -c nvim-config -n '__fish_seen_subcommand_from profile' -a unset  -d 'Remove .nvim-profile from the current directory'
complete -c nvim-config -n '__fish_seen_subcommand_from profile' -a create -d 'Generate a new profile template'

# ui subcommands
complete -c nvim-config -n '__fish_seen_subcommand_from ui' -a set   -d 'Write .nvim-ui at the config root'
complete -c nvim-config -n '__fish_seen_subcommand_from ui' -a unset -d 'Remove .nvim-ui (reverts to classic)'
complete -c nvim-config -n '__fish_seen_subcommand_from ui; and __fish_seen_subcommand_from set' \
  -a 'classic modern'

# theme subcommands
complete -c nvim-config -n '__fish_seen_subcommand_from theme' -a set   -d 'Write .nvim-theme at the config root'
complete -c nvim-config -n '__fish_seen_subcommand_from theme' -a unset -d 'Remove .nvim-theme (reverts to nightfox)'
EOF
}

show_completion() {
  local shell_name="$1"
  case "${shell_name}" in
    bash) _show_completion_bash ;;
    zsh)  _show_completion_zsh  ;;
    fish) _show_completion_fish ;;
    *)
      printf 'Unsupported shell: %s. Supported: bash, zsh, fish\n' "${shell_name}" >&2
      return 1
      ;;
  esac
}

install_completion() {
  local shell_name="$1"
  local completion_dir completion_file

  case "${shell_name}" in
    bash)
      completion_dir="${HOME}/.local/share/bash-completion/completions"
      completion_file="${completion_dir}/${SCRIPT_NAME}"
      ;;
    zsh)
      completion_dir="${HOME}/.zfunc"
      completion_file="${completion_dir}/_${SCRIPT_NAME}"
      ;;
    fish)
      completion_dir="${HOME}/.config/fish/completions"
      completion_file="${completion_dir}/${SCRIPT_NAME}.fish"
      ;;
    *)
      printf 'Unsupported shell: %s. Supported: bash, zsh, fish\n' "${shell_name}" >&2
      return 1
      ;;
  esac

  mkdir -p "${completion_dir}"
  show_completion "${shell_name}" > "${completion_file}"
  log_message "INFO" "Installed ${shell_name} completion to ${completion_file}"
}

run_install_claude() {
  if command -v claude > /dev/null 2>&1; then
    log_message "INFO" "claude is already installed — skipping"
    return 0
  fi
  if ! command -v npm > /dev/null 2>&1; then
    log_message "ERROR" "npm is required to install Claude Code — run 'install deps --with-node' first"
    return 1
  fi
  run_command npm install -g @anthropic-ai/claude-code
}

run_install_codex() {
  if command -v codex > /dev/null 2>&1; then
    log_message "INFO" "codex is already installed — skipping"
    return 0
  fi
  if ! command -v npm > /dev/null 2>&1; then
    log_message "ERROR" "npm is required to install Codex CLI — run 'install deps --with-node' first"
    return 1
  fi
  run_command npm install -g @openai/codex
}

run_install_nvim() {
  if command -v nvim > /dev/null 2>&1; then
    log_message "INFO" "nvim is already installed — skipping (use 'update nvim' to upgrade)"
    return 0
  fi

  case "${NVIM_PKG_MANAGER}" in
    snap)
      run_command sudo snap install nvim --classic
      ;;
    apt)
      run_command sudo apt update
      run_command sudo apt install neovim
      ;;
  esac
}

run_update_nvim() {
  if ! command -v nvim > /dev/null 2>&1; then
    log_message "ERROR" "nvim is not installed — run 'install nvim' first"
    return 1
  fi

  if snap list nvim > /dev/null 2>&1; then
    run_command sudo snap refresh nvim
  else
    run_command sudo apt install --only-upgrade neovim
  fi
}

run_update_plugins() {
  if ! command -v nvim > /dev/null 2>&1; then
    log_message "ERROR" "nvim is not installed — run 'install nvim' first"
    return 1
  fi
  run_command nvim --headless -u "${PROJECT_DIR}/init.lua" +"Lazy! sync" +qa
}

run_update() {
  local subcommand="${1:-all}"
  case "${subcommand}" in
    nvim)
      run_update_nvim
      ;;
    plugins)
      run_update_plugins
      ;;
    all)
      run_update_nvim
      run_update_plugins
      ;;
    *)
      printf 'Unknown update subcommand: %s\n' "${subcommand}" >&2
      print_usage
      exit 1
      ;;
  esac
}

run_profile_list() {
  local profiles_dir="${PROJECT_DIR}/lua/profiles"
  if [ ! -d "${profiles_dir}" ]; then
    log_message "ERROR" "No profiles directory found at ${profiles_dir}"
    return 1
  fi
  for f in "${profiles_dir}"/*.lua; do
    local name
    name="$(basename "$f" .lua)"
    if [ "${name}" != "init" ]; then
      log_message "INFO" "${name}"
    fi
  done
}

run_profile_detect() {
  local detected=()
  if [ -f "package.json" ]; then
    detected+=("web")
  fi
  if [ -f "Cargo.toml" ]; then
    detected+=("rust")
  fi
  if [ -f "composer.json" ]; then
    if grep -q "laravel/framework" composer.json 2>/dev/null; then
      detected+=("laravel")
    else
      detected+=("php")
    fi
  fi
  if [ "${#detected[@]}" -eq 0 ]; then
    log_message "INFO" "No profiles detected — using base"
  else
    log_message "INFO" "Detected profiles: ${detected[*]}"
  fi
}

run_profile_set() {
  local name="${1:?Missing profile name for: profile set}"
  local profile_file="${PWD}/.nvim-profile"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "printf '%s\\n' '${name}' > ${profile_file}"
    return 0
  fi
  printf '%s\n' "${name}" > "${profile_file}"
  log_message "INFO" "Profile '${name}' written to ${profile_file}"
}

run_profile_unset() {
  local profile_file="${PWD}/.nvim-profile"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "rm -f ${profile_file}"
    return 0
  fi
  if [ -f "${profile_file}" ]; then
    rm -f "${profile_file}"
    log_message "INFO" "Removed ${profile_file}"
  else
    log_message "INFO" "${profile_file} does not exist — nothing to do"
  fi
}

run_profile_create() {
  local name="${1:?Missing profile name for: profile create}"
  local profile_file="${PROJECT_DIR}/lua/profiles/${name}.lua"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "Generate profile template: lua/profiles/${name}.lua"
    return 0
  fi
  if [ -f "${profile_file}" ]; then
    log_message "ERROR" "${profile_file} already exists — remove it first"
    return 1
  fi
  cat > "${profile_file}" << LUAEOF
-- lua/profiles/${name}.lua

return {
    name = '${name}',
    extends = {},

    lsp_servers = {},

    plugins = {},

    null_ls_sources = function(null_ls)
        return {}
    end,
}
LUAEOF
  log_message "INFO" "Profile template created: ${profile_file}"
}

run_profile() {
  case "${PROFILE_SUBCOMMAND:-list}" in
    list)
      run_profile_list
      ;;
    detect)
      run_profile_detect
      ;;
    set)
      if [ -z "${PROFILE_NAME}" ]; then
        printf 'Missing profile name for: profile set\n' >&2
        exit 1
      fi
      run_profile_set "${PROFILE_NAME}"
      ;;
    unset)
      run_profile_unset
      ;;
    create)
      if [ -z "${PROFILE_NAME}" ]; then
        printf 'Missing profile name for: profile create\n' >&2
        exit 1
      fi
      run_profile_create "${PROFILE_NAME}"
      ;;
    *)
      printf 'Unknown profile subcommand: %s\n' "${PROFILE_SUBCOMMAND}" >&2
      print_usage
      exit 1
      ;;
  esac
}

run_ui_set() {
  local variant="${1:?Missing variant for: ui set (classic|modern)}"
  if [[ "${variant}" != "classic" && "${variant}" != "modern" ]]; then
    printf 'Unknown UI variant: %s. Use classic or modern.\n' "${variant}" >&2
    return 1
  fi
  local ui_file="${PROJECT_DIR}/.nvim-ui"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "printf '%s\\n' '${variant}' > ${ui_file}"
    return 0
  fi
  printf '%s\n' "${variant}" > "${ui_file}"
  log_message "INFO" "UI variant '${variant}' written to ${ui_file}"
}

run_ui_unset() {
  local ui_file="${PROJECT_DIR}/.nvim-ui"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "rm -f ${ui_file}"
    return 0
  fi
  if [ -f "${ui_file}" ]; then
    rm -f "${ui_file}"
    log_message "INFO" "Removed ${ui_file} — reverts to classic"
  else
    log_message "INFO" "${ui_file} does not exist — nothing to do"
  fi
}

run_ui() {
  case "${UI_SUBCOMMAND:-}" in
    set)
      if [ -z "${UI_VARIANT}" ]; then
        printf 'Missing variant for: ui set (classic|modern)\n' >&2
        exit 1
      fi
      run_ui_set "${UI_VARIANT}"
      ;;
    unset)
      run_ui_unset
      ;;
    *)
      printf 'Unknown ui subcommand: %s\n' "${UI_SUBCOMMAND}" >&2
      print_usage
      exit 1
      ;;
  esac
}

run_theme_set() {
  local name="${1:?Missing theme name for: theme set}"
  local theme_file="${PROJECT_DIR}/.nvim-theme"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "printf '%s\\n' '${name}' > ${theme_file}"
    return 0
  fi
  printf '%s\n' "${name}" > "${theme_file}"
  log_message "INFO" "Theme '${name}' written to ${theme_file}"
}

run_theme_unset() {
  local theme_file="${PROJECT_DIR}/.nvim-theme"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "rm -f ${theme_file}"
    return 0
  fi
  if [ -f "${theme_file}" ]; then
    rm -f "${theme_file}"
    log_message "INFO" "Removed ${theme_file} — reverts to nightfox"
  else
    log_message "INFO" "${theme_file} does not exist — nothing to do"
  fi
}

run_theme() {
  case "${THEME_SUBCOMMAND:-}" in
    set)
      if [ -z "${THEME_NAME}" ]; then
        printf 'Missing theme name for: theme set\n' >&2
        exit 1
      fi
      run_theme_set "${THEME_NAME}"
      ;;
    unset)
      run_theme_unset
      ;;
    *)
      printf 'Unknown theme subcommand: %s\n' "${THEME_SUBCOMMAND}" >&2
      print_usage
      exit 1
      ;;
  esac
}

run_install_tmux() {
  local tmux_conf="${HOME}/.tmux.conf"
  local source_line="source-file ${PROJECT_DIR}/.tmux.conf"

  if [ -f "${tmux_conf}" ] && grep -qF "${source_line}" "${tmux_conf}"; then
    log_message "INFO" "${tmux_conf} already sources ${PROJECT_DIR}/.tmux.conf — skipping"
    return 0
  fi

  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "printf '\\n%s\\n' '${source_line}' >> ${tmux_conf}"
    return 0
  fi

  printf '\n%s\n' "${source_line}" >> "${tmux_conf}"
  log_message "INFO" "Added source-file entry to ${tmux_conf}"
}

run_install_node() {
  if [ -d "${NVM_DIR}" ]; then
    log_message "INFO" "nvm already installed at ${NVM_DIR} — skipping nvm install"
  else
    run_command bash -c "curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v${NVM_VERSION}/install.sh | bash"
  fi
  run_command bash -c ". ${NVM_DIR}/nvm.sh && nvm install --lts"
}

run_install_deps() {
  run_command sudo apt update
  run_command sudo apt install curl ripgrep fd-find xsel xclip lolcat
  if [ "${WITH_NODE}" -eq 1 ]; then
    run_install_node
  fi
}

run_install_config() {
  local nvim_config_dir="${HOME}/.config/nvim"

  if [ -L "${nvim_config_dir}" ]; then
    local current_target
    current_target="$(readlink -f "${nvim_config_dir}")"
    if [ "${current_target}" = "${PROJECT_DIR}" ]; then
      log_message "INFO" "${nvim_config_dir} is already linked to ${PROJECT_DIR}"
      return 0
    fi
    log_message "ERROR" "${nvim_config_dir} is a symlink to ${current_target}, not ${PROJECT_DIR} — remove it manually first"
    return 1
  fi

  if [ -e "${nvim_config_dir}" ]; then
    log_message "ERROR" "${nvim_config_dir} exists and is not a symlink — remove it manually first"
    return 1
  fi

  run_command mkdir -p "${HOME}/.config"
  run_command ln -s "${PROJECT_DIR}" "${nvim_config_dir}"
  log_message "INFO" "Linked ${nvim_config_dir} → ${PROJECT_DIR}"
}

run_install() {
  local subcommand="${1:-all}"
  case "${subcommand}" in
    deps)
      run_install_deps
      ;;
    config)
      run_install_config
      ;;
    tmux)
      run_install_tmux
      ;;
    nvim)
      run_install_nvim
      ;;
    claude)
      run_install_claude
      ;;
    codex)
      run_install_codex
      ;;
    all)
      run_install_nvim
      run_install_deps
      run_install_config
      ;;
    *)
      printf 'Unknown install subcommand: %s\n' "${subcommand}" >&2
      print_usage
      exit 1
      ;;
  esac
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      print_usage
      exit 0
      ;;
    -V|--version)
      read_version
      exit 0
      ;;
    -v|--verbose)
      VERBOSE=1
      shift
      ;;
    -q|--quiet)
      QUIET=1
      shift
      ;;
    --debug)
      DEBUG=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --no-color)
      NO_COLOR=1
      shift
      ;;
    --no-log)
      NO_LOG=1
      shift
      ;;
    --with-node)
      WITH_NODE=1
      shift
      ;;
    --snap)
      NVIM_PKG_MANAGER="snap"
      shift
      ;;
    --apt)
      NVIM_PKG_MANAGER="apt"
      shift
      ;;
    --log-dir)
      LOG_DIR="${2:?Missing value for --log-dir}"
      shift 2
      ;;
    --show-completion)
      COMPLETION_SHELL="${2:?Missing shell name for --show-completion}"
      COMMAND="show-completion"
      shift 2
      ;;
    --install-completion)
      COMPLETION_SHELL="${2:?Missing shell name for --install-completion}"
      COMMAND="install-completion"
      shift 2
      ;;
    install)
      COMMAND="install"
      shift
      if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
        SUBCOMMAND="$1"
        shift
      fi
      ;;
    update)
      COMMAND="update"
      shift
      if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
        SUBCOMMAND="$1"
        shift
      fi
      ;;
    profile)
      COMMAND="profile"
      shift
      if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
        PROFILE_SUBCOMMAND="$1"
        shift
        if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
          PROFILE_NAME="$1"
          shift
        fi
      fi
      ;;
    ui)
      COMMAND="ui"
      shift
      if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
        UI_SUBCOMMAND="$1"
        shift
        if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
          UI_VARIANT="$1"
          shift
        fi
      fi
      ;;
    theme)
      COMMAND="theme"
      shift
      if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
        THEME_SUBCOMMAND="$1"
        shift
        if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
          THEME_NAME="$1"
          shift
        fi
      fi
      ;;
    *)
      printf 'Unknown argument: %s\n' "$1" >&2
      exit 1
      ;;
  esac
done

if [ "${DEBUG}" -eq 1 ]; then
  set -x
fi

setup_logging

case "${COMMAND}" in
  show-completion)
    show_completion "${COMPLETION_SHELL}"
    ;;
  install-completion)
    install_completion "${COMPLETION_SHELL}"
    ;;
  install)
    run_install "${SUBCOMMAND}"
    ;;
  update)
    run_update "${SUBCOMMAND}"
    ;;
  profile)
    run_profile
    ;;
  ui)
    run_ui
    ;;
  theme)
    run_theme
    ;;
  *)
    print_usage
    exit 1
    ;;
esac
