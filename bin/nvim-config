#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
SCRIPT_NAME="nvim-config"
VERSION_FILE="${PROJECT_DIR}/VERSION"

QUIET=0
VERBOSE=0
DRY_RUN=0
DEBUG=0
# Respect NO_COLOR env var (https://no-color.org)
if [[ -n "${NO_COLOR:-}" ]]; then
  NO_COLOR=1
else
  NO_COLOR=0
fi
NO_LOG=0
WITH_NODE=0
COMMAND=""
SUBCOMMAND=""
COMPLETION_SHELL=""

NVM_VERSION="0.39.7"
NVM_DIR="${HOME}/.nvm"

LOG_DIR_DEFAULT="${NVIM_CONFIG_LOG_DIR:-${HOME}/.local/state/${SCRIPT_NAME}/logs}"
LOG_DIR="${LOG_DIR_DEFAULT}"
LOG_FILE=""

print_usage() {
  cat <<'EOF'
Usage:
  nvim-config [global-options] <command> [subcommand]
  nvim-config [global-options] --show-completion bash
  nvim-config [global-options] --install-completion bash

Commands:
  install [deps|config|all] [--with-node]
                        Install system dependencies and/or config symlink
                          deps   — install apt packages only
                          config — symlink ~/.config/nvim to this repository
                          all    — deps then config (default)
                        --with-node
                               Also install nvm and Node.js LTS (opt-in).
                               Skipped if nvm is already present at ~/.nvm.

Global options:
  -h, --help            Display usage and exit
  -V, --version         Display version and exit
  -v, --verbose         Enable debug-level output
  -q, --quiet           Suppress terminal output
      --debug           Enable shell trace mode
      --dry-run         Simulate execution without making any changes
      --no-color        Disable colored output
      --no-log          Disable file logging
      --log-dir <path>  Override the log directory
      --show-completion bash
                        Print the bash completion script
      --install-completion bash
                        Install bash completion for the current user
EOF
}

read_version() {
  tr -d '\n' < "${VERSION_FILE}"
}

setup_logging() {
  if [ "${NO_LOG}" -eq 0 ]; then
    mkdir -p "${LOG_DIR}"
    LOG_FILE="${LOG_DIR}/${SCRIPT_NAME}-$(date +%F).log"
    : > "${LOG_FILE}"
  fi
}

_color_for_level() {
  case "$1" in
    INFO)  printf '\033[0;37m' ;;
    WARN)  printf '\033[0;33m' ;;
    ERROR) printf '\033[0;31m' ;;
    DEBUG) printf '\033[0;36m' ;;
  esac
}

log_message() {
  local level="$1"
  shift
  local message="$*"
  local timestamp
  timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
  local plain_line="[${timestamp}] [${level}] ${message}"

  if [ "${QUIET}" -eq 0 ]; then
    if [ "${NO_COLOR}" -eq 0 ] && [ -t 1 ]; then
      printf '%s%s\033[0m\n' "$(_color_for_level "${level}")" "${plain_line}"
    else
      printf '%s\n' "${plain_line}"
    fi
  fi

  if [ "${level}" = "ERROR" ]; then
    printf '%s\n' "${plain_line}" >&2
  fi

  if [ -n "${LOG_FILE}" ]; then
    printf '%s\n' "${plain_line}" >> "${LOG_FILE}"
  fi
}

run_command() {
  local command_text="$*"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "${command_text}"
    return 0
  fi

  log_message "INFO" "${command_text}"
  "$@"
}

show_completion() {
  local shell_name="$1"
  if [ "${shell_name}" != "bash" ]; then
    printf 'Only bash completion is supported in this version.\n' >&2
    return 1
  fi

  cat <<'EOF'
_nvim_config_completions() {
  local current_word previous_word
  current_word="${COMP_WORDS[COMP_CWORD]}"
  previous_word="${COMP_WORDS[COMP_CWORD-1]}"

  case "${previous_word}" in
    --show-completion|--install-completion)
      COMPREPLY=( $(compgen -W "bash" -- "${current_word}") )
      return 0
      ;;
    install|deps|config|all)
      COMPREPLY=( $(compgen -W "deps config all --with-node" -- "${current_word}") )
      return 0
      ;;
  esac

  if [ "${COMP_CWORD}" -eq 1 ]; then
    COMPREPLY=( $(compgen -W "--help --version --verbose --quiet --debug --dry-run --no-color --no-log --log-dir --show-completion --install-completion install" -- "${current_word}") )
    return 0
  fi

  COMPREPLY=()
}

complete -F _nvim_config_completions nvim-config
EOF
}

install_completion() {
  local shell_name="$1"
  if [ "${shell_name}" != "bash" ]; then
    printf 'Only bash completion is supported in this version.\n' >&2
    return 1
  fi

  local completion_dir="${HOME}/.local/share/bash-completion/completions"
  mkdir -p "${completion_dir}"
  show_completion bash > "${completion_dir}/${SCRIPT_NAME}"
  log_message "INFO" "Installed bash completion to ${completion_dir}/${SCRIPT_NAME}"
}

run_install_node() {
  if [ -d "${NVM_DIR}" ]; then
    log_message "INFO" "nvm already installed at ${NVM_DIR} — skipping nvm install"
  else
    run_command bash -c "curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v${NVM_VERSION}/install.sh | bash"
  fi
  run_command bash -c ". ${NVM_DIR}/nvm.sh && nvm install --lts"
}

run_install_deps() {
  run_command sudo apt update
  run_command sudo apt install curl ripgrep fd-find xsel xclip lolcat
  if [ "${WITH_NODE}" -eq 1 ]; then
    run_install_node
  fi
}

run_install_config() {
  local nvim_config_dir="${HOME}/.config/nvim"

  if [ -L "${nvim_config_dir}" ]; then
    local current_target
    current_target="$(readlink -f "${nvim_config_dir}")"
    if [ "${current_target}" = "${PROJECT_DIR}" ]; then
      log_message "INFO" "${nvim_config_dir} is already linked to ${PROJECT_DIR}"
      return 0
    fi
    log_message "ERROR" "${nvim_config_dir} is a symlink to ${current_target}, not ${PROJECT_DIR} — remove it manually first"
    return 1
  fi

  if [ -e "${nvim_config_dir}" ]; then
    log_message "ERROR" "${nvim_config_dir} exists and is not a symlink — remove it manually first"
    return 1
  fi

  run_command mkdir -p "${HOME}/.config"
  run_command ln -s "${PROJECT_DIR}" "${nvim_config_dir}"
  log_message "INFO" "Linked ${nvim_config_dir} → ${PROJECT_DIR}"
}

run_install() {
  local subcommand="${1:-all}"
  case "${subcommand}" in
    deps)
      run_install_deps
      ;;
    config)
      run_install_config
      ;;
    all)
      run_install_deps
      run_install_config
      ;;
    *)
      printf 'Unknown install subcommand: %s\n' "${subcommand}" >&2
      print_usage
      exit 1
      ;;
  esac
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      print_usage
      exit 0
      ;;
    -V|--version)
      read_version
      exit 0
      ;;
    -v|--verbose)
      VERBOSE=1
      shift
      ;;
    -q|--quiet)
      QUIET=1
      shift
      ;;
    --debug)
      DEBUG=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --no-color)
      NO_COLOR=1
      shift
      ;;
    --no-log)
      NO_LOG=1
      shift
      ;;
    --with-node)
      WITH_NODE=1
      shift
      ;;
    --log-dir)
      LOG_DIR="${2:?Missing value for --log-dir}"
      shift 2
      ;;
    --show-completion)
      COMPLETION_SHELL="${2:?Missing shell name for --show-completion}"
      COMMAND="show-completion"
      shift 2
      ;;
    --install-completion)
      COMPLETION_SHELL="${2:?Missing shell name for --install-completion}"
      COMMAND="install-completion"
      shift 2
      ;;
    install)
      COMMAND="install"
      shift
      if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
        SUBCOMMAND="$1"
        shift
      fi
      ;;
    *)
      printf 'Unknown argument: %s\n' "$1" >&2
      exit 1
      ;;
  esac
done

if [ "${DEBUG}" -eq 1 ]; then
  set -x
fi

setup_logging

case "${COMMAND}" in
  show-completion)
    show_completion "${COMPLETION_SHELL}"
    ;;
  install-completion)
    install_completion "${COMPLETION_SHELL}"
    ;;
  install)
    run_install "${SUBCOMMAND}"
    ;;
  *)
    print_usage
    exit 1
    ;;
esac
