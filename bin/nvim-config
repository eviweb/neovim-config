#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks so PROJECT_DIR points to the repo root even when
# nvim-config is invoked via a symlink (e.g. ~/bin/nvim-config → repo/bin/).
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
SCRIPT_NAME="nvim-config"
VERSION_FILE="${PROJECT_DIR}/VERSION"

QUIET=0
VERBOSE=0
DRY_RUN=0
DEBUG=0
PROFILE_SUBCOMMAND=""
PROFILE_NAME=""
UI_SUBCOMMAND=""
UI_VARIANT=""
THEME_SUBCOMMAND=""
THEME_NAME=""
# Respect NO_COLOR env var (https://no-color.org)
if [[ -n "${NO_COLOR:-}" ]]; then
  NO_COLOR=1
else
  NO_COLOR=0
fi
NO_LOG=0
WITH_NODE=0
ACTIVATE_MODE="prompt"
MISE_ACTIVATION_PENDING=0
NVIM_PKG_MANAGER="auto"
MISE_GPG_KEY_FINGERPRINT="24853EC9F655CE80B48E6C3A8B81C9D17413A06D"
COMMAND=""
SUBCOMMAND=""
COMPLETION_SHELL=""

VALID_THEMES=(
  carbonfox
  catppuccin-frappe catppuccin-macchiato catppuccin-mocha
  duskfox
  gruvbox-material
  kanagawa-dragon kanagawa-wave
  nightfox nordfox
  terafox
  tokyonight-moon tokyonight-night tokyonight-storm
)

NVM_VERSION="0.39.7"
NVM_DIR="${HOME}/.nvm"

LOG_DIR_DEFAULT="${NVIM_CONFIG_LOG_DIR:-${HOME}/.local/state/${SCRIPT_NAME}/logs}"
LOG_DIR="${LOG_DIR_DEFAULT}"
LOG_FILE=""

print_usage() {
  cat <<'EOF'
Usage:
  nvim-config [global-options] <command> [subcommand]
  nvim-config [global-options] --show-completion bash
  nvim-config [global-options] --install-completion bash

Commands:
  install [deps|config|all|tmux|nvim|mise|claude|codex|gemini] [--with-node] [--snap|--apt|--mise] [--activate|--no-activate]
                        Install system dependencies and/or config symlinks
                          deps   — install apt packages only
                          config — symlink ~/.config/nvim to this repository
                          tmux   — inject source-file entry into ~/.tmux.conf
                          nvim   — install Neovim (prefers mise when present on PATH, snap otherwise)
                          mise   — install the mise version manager (curl + GPG-verified installer)
                          claude — install Claude Code CLI (requires Node.js)
                          codex  — install OpenAI Codex CLI (requires Node.js)
                          gemini — install Gemini CLI (requires Node.js)
                          all    — nvim, deps, then config
                        --with-node
                               Also install nvm and Node.js LTS (opt-in).
                               Skipped if nvm is already present at ~/.nvm.
                        --snap  Force Neovim install via snap (installs snapd first if missing)
                        --apt   Force Neovim install via apt
                        --mise  Force Neovim install via mise (installs mise + missing
                               prerequisites first if needed, no extra prompt)
                        --activate
                               Add mise's shell activation line unattended, no prompt
                               (for automated/non-interactive installs).
                        --no-activate
                               Skip the mise shell-activation step entirely, no prompt
                               (for automated/non-interactive installs).

  uninstall [config|nvim|mise|deps|all]
                        Reverse the corresponding install subcommand(s)
                          config — remove the ~/.config/nvim symlink (only if it points here)
                          nvim   — remove Neovim (detects mise/snap/apt, asks for confirmation)
                          mise   — remove the mise binary and its shell activation lines
                                   (asks for confirmation; tools it managed are left untouched)
                          deps   — never removes apt packages (they may be shared with other
                                   tools); prints the manual removal command instead
                          all    — config, nvim, then mise (deps stays informational, see above)

  update [nvim|plugins|dap-adapters|tree-sitter|all]
                        Update Neovim, plugins, or DAP adapters
                          nvim         — refresh Neovim (mise, snap, or apt — auto-detected)
                          plugins      — run Lazy! sync headlessly
                          dap-adapters — install/update Mason DAP packages for active profile
                          tree-sitter  — download latest tree-sitter CLI binary into vendor/
                          all          — nvim, plugins, then tree-sitter (default)

  profile [list|detect|set|unset|create|info] [<name>]
                        Manage per-project Neovim profiles
                          list   — list available profiles (marks active with *)
                          detect — detect profiles for the current directory
                          set    — write .nvim-profile in the current directory
                          unset  — remove .nvim-profile from the current directory
                          create — generate a new profile template in lua/profiles/
                          info   — show active profile details (LSP servers, DAP packages)

  ui [set|unset|info] [classic|modern]
                        Manage the active UI variant
                          set    — write .nvim-ui at the config root
                          unset  — remove .nvim-ui (reverts to classic)
                          info   — show the active UI variant

  theme [set|unset|info|list] [<name>]
                        Manage the active colorscheme
                          set    — write .nvim-theme at the config root
                          unset  — remove .nvim-theme (reverts to nightfox)
                          info   — show the active theme
                          list   — list all available themes (marks active with *)

  status                Show current configuration summary (nvim, UI, theme, profile)

  doctor                Check that required tools and binaries are installed

  keymaps               Open the keymaps reference in \$PAGER

Global options:
  -h, --help            Display usage and exit
  -V, --version         Display version and exit
  -v, --verbose         Enable debug-level output
  -q, --quiet           Suppress terminal output
      --debug           Enable shell trace mode
      --dry-run         Simulate execution without making any changes
      --no-color        Disable colored output
      --no-log          Disable file logging
      --log-dir <path>  Override the log directory
      --show-completion bash|zsh|fish
                        Print the completion script for the given shell
      --install-completion bash|zsh|fish
                        Install completion for the given shell
EOF
}

read_version() {
  tr -d '\n' < "${VERSION_FILE}"
}

setup_logging() {
  if [ "${NO_LOG}" -eq 0 ]; then
    mkdir -p "${LOG_DIR}"
    LOG_FILE="${LOG_DIR}/${SCRIPT_NAME}-$(date +%F).log"
    : > "${LOG_FILE}"
  fi
}

_color_for_level() {
  case "$1" in
    INFO)  printf '\033[0;37m' ;;
    WARN)  printf '\033[0;33m' ;;
    ERROR) printf '\033[0;31m' ;;
    DEBUG) printf '\033[0;36m' ;;
  esac
}

log_message() {
  local level="$1"
  shift
  local message="$*"
  local timestamp
  timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
  local plain_line="[${timestamp}] [${level}] ${message}"

  if [ "${level}" = "ERROR" ]; then
    if [ "${NO_COLOR}" -eq 0 ] && [ -t 2 ]; then
      printf '%s%s\033[0m\n' "$(_color_for_level "${level}")" "${plain_line}" >&2
    else
      printf '%s\n' "${plain_line}" >&2
    fi
  elif [ "${QUIET}" -eq 0 ]; then
    if [ "${level}" = "DEBUG" ] && [ "${VERBOSE}" -eq 0 ]; then
      :
    elif [ "${NO_COLOR}" -eq 0 ] && [ -t 1 ]; then
      printf '%s%s\033[0m\n' "$(_color_for_level "${level}")" "${plain_line}"
    else
      printf '%s\n' "${plain_line}"
    fi
  fi

  if [ -n "${LOG_FILE}" ]; then
    printf '%s\n' "${plain_line}" >> "${LOG_FILE}"
  fi
}

run_command() {
  local command_text="$*"
  if [ "${DRY_RUN}" -eq 1 ]; then
    log_message "INFO" "${command_text}"
    return 0
  fi

  log_message "INFO" "${command_text}"
  "$@"
}

_read_active_theme() {
  local theme_file="${PROJECT_DIR}/.nvim-theme"
  if [ -f "${theme_file}" ]; then
    tr -d '[:space:]' < "${theme_file}"
  else
    printf 'nightfox'
  fi
}

_read_active_ui() {
  local ui_file="${PROJECT_DIR}/.nvim-ui"
  if [ -f "${ui_file}" ]; then
    tr -d '[:space:]' < "${ui_file}"
  else
    printf 'classic'
  fi
}

_read_active_profile() {
  local profile_file="${PWD}/.nvim-profile"
  if [ -f "${profile_file}" ]; then
    tr -d '[:space:]' < "${profile_file}"
  fi
}

# Extract single-quoted string values from a Lua list declaration.
# Usage: _extract_lua_list <file> <key>
_extract_lua_list() {
  local file="$1"
  local key="$2"
  awk -v k="${key}" '
    $0 ~ k"[[:space:]]*=" { in_list=1 }
    in_list { print }
    /}/ { if (in_list) { in_list=0 } }
  ' "${file}" | grep -oP "'\K[^']+"
}

_check_bin() {
  local bin="$1"
  if command -v "${bin}" > /dev/null 2>&1; then
    log_message "INFO" "  [ok]  ${bin}"
  else
    log_message "WARN" "  [!!]  ${bin} — not found"
    return 1
  fi
}

run_status() {
  local nvim_version="not installed"
  if command -v nvim > /dev/null 2>&1; then
    nvim_version="$(nvim --version 2>/dev/null | head -1 | sed 's/NVIM //')"
  fi
  local theme; theme="$(_read_active_theme)"
  local ui; ui="$(_read_active_ui)"
  local profile; profile="$(_read_active_profile)"
  [ -z "${profile}" ] && profile="(none)"
  log_message "INFO" "Neovim  : ${nvim_version}"
  log_message "INFO" "UI      : ${ui}"
  log_message "INFO" "Theme   : ${theme}"
  log_message "INFO" "Profile : ${profile}"
}

run_doctor() {
  local all_ok=1

  log_message "INFO" "=== Neovim ==="
  if command -v nvim > /dev/null 2>&1; then
    local ver
    ver="$(nvim --version 2>/dev/null | head -1)"
    log_message "INFO" "  [ok]  ${ver}"
  else
    log_message "ERROR" "  [!!]  nvim — not installed"
    all_ok=0
  fi

  if [ -n "${TERMUX_VERSION:-}" ]; then
    log_message "INFO" "=== Termux environment (Android ${TERMUX_VERSION}) ==="
    for bin in git make rg fd node npm; do
      _check_bin "${bin}" || all_ok=0
    done
    log_message "INFO" "=== Optional tools ==="
    for bin in lazygit tmux mise claude codex gemini; do
      _check_bin "${bin}" || true
    done
    log_message "INFO" "=== Build tools ==="
    _check_bin "clang" || true
    _check_bin "make"  || true
  else
    log_message "INFO" "=== Required binaries ==="
    for bin in git make gcc rg fdfind node npm; do
      _check_bin "${bin}" || all_ok=0
    done
    log_message "INFO" "=== Optional tools ==="
    for bin in lazygit tmux mise claude codex gemini; do
      _check_bin "${bin}" || true
    done
    log_message "INFO" "=== Python tools (optional) ==="
    for bin in python3 pyright ruff black mypy; do
      _check_bin "${bin}" || true
    done
    log_message "INFO" "=== Build tools (optional) ==="
    _check_bin "cargo" || true
  fi

  if [ "${all_ok}" -eq 1 ]; then
    log_message "INFO" "All required checks passed."
  else
    log_message "WARN" "Some required tools are missing — run 'install deps' to fix."
    return 1
  fi
}

run_keymaps() {
  local keymaps_file="${PROJECT_DIR}/docs/keymaps.md"
  if [ ! -f "${keymaps_file}" ]; then
    log_message "ERROR" "Keymaps file not found: ${keymaps_file}"
    return 1
  fi
  "${PAGER:-less}" "${keymaps_file}"
}

_show_completion_bash() {
  cat <<'EOF'
_nvim_config_completions() {
  local current_word previous_word top_word
  current_word="${COMP_WORDS[COMP_CWORD]}"
  previous_word="${COMP_WORDS[COMP_CWORD-1]}"
  top_word="${COMP_WORDS[1]}"

  case "${previous_word}" in
    --show-completion|--install-completion)
      COMPREPLY=( $(compgen -W "bash zsh fish" -- "${current_word}") )
      return 0
      ;;
  esac

  # Dispatch on the top-level command first — "set"/"unset"/"info" are
  # shared subcommand names across profile/ui/theme, so matching on
  # previous_word alone (as this used to) is ambiguous: e.g. "ui set <TAB>"
  # would incorrectly offer profile's subcommand list instead of
  # classic/modern.
  case "${top_word}" in
    install)
      COMPREPLY=( $(compgen -W "deps config all tmux nvim mise claude codex gemini --with-node --snap --apt --mise --activate --no-activate" -- "${current_word}") )
      return 0
      ;;
    uninstall)
      COMPREPLY=( $(compgen -W "config nvim mise deps all" -- "${current_word}") )
      return 0
      ;;
    update)
      COMPREPLY=( $(compgen -W "nvim plugins dap-adapters tree-sitter all" -- "${current_word}") )
      return 0
      ;;
    profile)
      if [ "${previous_word}" = "profile" ]; then
        COMPREPLY=( $(compgen -W "list detect set unset create info" -- "${current_word}") )
      else
        COMPREPLY=()
      fi
      return 0
      ;;
    ui)
      case "${previous_word}" in
        ui)  COMPREPLY=( $(compgen -W "info set unset" -- "${current_word}") ) ;;
        set) COMPREPLY=( $(compgen -W "classic modern" -- "${current_word}") ) ;;
        *)   COMPREPLY=() ;;
      esac
      return 0
      ;;
    theme)
      case "${previous_word}" in
        theme) COMPREPLY=( $(compgen -W "info list set unset" -- "${current_word}") ) ;;
        set)   COMPREPLY=( $(compgen -W "__VALID_THEMES__" -- "${current_word}") ) ;;
        *)     COMPREPLY=() ;;
      esac
      return 0
      ;;
  esac

  if [ "${COMP_CWORD}" -eq 1 ]; then
    COMPREPLY=( $(compgen -W "--help --version --verbose --quiet --debug --dry-run --no-color --no-log --log-dir --show-completion --install-completion install uninstall update profile ui theme status doctor keymaps" -- "${current_word}") )
    return 0
  fi

  COMPREPLY=()
}

complete -F _nvim_config_completions nvim-config
EOF
}

_show_completion_zsh() {
  cat <<'EOF'
#compdef nvim-config

_nvim_config() {
  local -a commands global_opts install_subcmds uninstall_subcmds

  global_opts=(
    '--help[Display usage and exit]'
    '--version[Display version and exit]'
    '--verbose[Enable debug-level output]'
    '--quiet[Suppress terminal output]'
    '--debug[Enable shell trace mode]'
    '--dry-run[Simulate execution without making changes]'
    '--no-color[Disable colored output]'
    '--no-log[Disable file logging]'
    '--log-dir[Override the log directory]:directory:_directories'
    '--show-completion[Print the completion script]:shell:(bash zsh fish)'
    '--install-completion[Install completion for the current user]:shell:(bash zsh fish)'
  )

  commands=(
    'install:Install system dependencies and/or config symlinks'
    'update:Update Neovim and/or plugins'
  )

  install_subcmds=(
    'deps:Install apt packages only'
    'config:Symlink ~/.config/nvim to this repository'
    'all:Install nvim, deps, then config'
    'tmux:Inject source-file entry into ~/.tmux.conf'
    'nvim:Install Neovim (prefers mise when present, snap otherwise)'
    'mise:Install the mise version manager (curl + GPG-verified installer)'
    'claude:Install Claude Code CLI (requires Node.js)'
    'codex:Install OpenAI Codex CLI (requires Node.js)'
    'gemini:Install Gemini CLI (requires Node.js)'
    '--with-node[Also install nvm and Node.js LTS]'
    '--snap[Force Neovim install via snap]'
    '--apt[Force Neovim install via apt]'
    '--mise[Force Neovim install via mise (installs mise first if missing)]'
    '--activate[Add mise shell activation unattended, no prompt]'
    '--no-activate[Skip the mise shell-activation step, no prompt]'
  )

  uninstall_subcmds=(
    'config:Remove the ~/.config/nvim symlink (only if it points here)'
    'nvim:Remove Neovim (detects mise/snap/apt, asks for confirmation)'
    'mise:Remove the mise binary and its shell activation lines'
    'deps:Never removes apt packages; prints the manual removal command instead'
    'all:config, nvim, then mise (deps stays informational)'
  )

  update_subcmds=(
    'nvim:Refresh Neovim (snap or apt, auto-detected)'
    'plugins:Run Lazy! sync headlessly'
    'dap-adapters:Install/update Mason DAP packages for active profile'
    'tree-sitter:Download latest tree-sitter CLI binary into vendor/'
    'all:Update nvim, plugins, then tree-sitter (default)'
  )

  profile_subcmds=(
    'list:List available profiles (marks active with *)'
    'detect:Detect profiles for the current directory'
    'set:Write .nvim-profile in the current directory'
    'unset:Remove .nvim-profile from the current directory'
    'create:Generate a new profile template in lua/profiles/'
    'info:Show active profile details'
  )

  ui_subcmds=(
    'info:Show the active UI variant'
    'set:Write .nvim-ui at the config root'
    'unset:Remove .nvim-ui (reverts to classic)'
  )

  theme_subcmds=(
    'info:Show the active theme'
    'list:List all available themes'
    'set:Write .nvim-theme at the config root'
    'unset:Remove .nvim-theme (reverts to nightfox)'
  )

  commands=(
    'install:Install system dependencies and/or config symlinks'
    'uninstall:Reverse the corresponding install subcommand(s)'
    'update:Update Neovim, plugins, or DAP adapters'
    'profile:Manage per-project Neovim profiles'
    'ui:Manage the active UI variant'
    'theme:Manage the active colorscheme'
    'status:Show current configuration summary'
    'doctor:Check that required tools and binaries are installed'
    'keymaps:Open the keymaps reference in $PAGER'
  )

  case "${words[2]}" in
    install)
      _arguments : "${install_subcmds[@]}"
      ;;
    uninstall)
      _arguments : "${uninstall_subcmds[@]}"
      ;;
    update)
      _arguments : "${update_subcmds[@]}"
      ;;
    profile)
      _arguments : "${profile_subcmds[@]}"
      ;;
    ui)
      if [[ "${words[3]}" == "set" ]]; then
        _arguments : '1:variant:(classic modern)'
      else
        _arguments : "${ui_subcmds[@]}"
      fi
      ;;
    theme)
      if [[ "${words[3]}" == "set" ]]; then
        _arguments : '1:theme:(__VALID_THEMES__)'
      else
        _arguments : "${theme_subcmds[@]}"
      fi
      ;;
    status|doctor|keymaps)
      ;;
    *)
      _arguments : "${global_opts[@]}" "${commands[@]}"
      ;;
  esac
}

_nvim_config "$@"
EOF
}

_show_completion_fish() {
  cat <<'EOF'
# Fish shell completion for nvim-config

# Disable file completion by default
complete -c nvim-config -f

# Global options
complete -c nvim-config -l help              -d 'Display usage and exit'
complete -c nvim-config -l version           -d 'Display version and exit'
complete -c nvim-config -l verbose           -d 'Enable debug-level output'
complete -c nvim-config -l quiet             -d 'Suppress terminal output'
complete -c nvim-config -l debug             -d 'Enable shell trace mode'
complete -c nvim-config -l dry-run           -d 'Simulate execution without making changes'
complete -c nvim-config -l no-color          -d 'Disable colored output'
complete -c nvim-config -l no-log            -d 'Disable file logging'
complete -c nvim-config -l log-dir           -d 'Override the log directory' -r
complete -c nvim-config -l show-completion   -d 'Print the completion script' -a 'bash zsh fish'
complete -c nvim-config -l install-completion -d 'Install completion for the current user' -a 'bash zsh fish'

# Top-level commands (shown when no subcommand has been typed yet)
complete -c nvim-config -n 'not __fish_seen_subcommand_from install uninstall update profile ui theme status doctor keymaps' \
  -a install -d 'Install system dependencies and/or config symlinks'
complete -c nvim-config -n 'not __fish_seen_subcommand_from install uninstall update profile ui theme status doctor keymaps' \
  -a uninstall -d 'Reverse the corresponding install subcommand(s)'
complete -c nvim-config -n 'not __fish_seen_subcommand_from install uninstall update profile ui theme status doctor keymaps' \
  -a update  -d 'Update Neovim, plugins, or DAP adapters'
complete -c nvim-config -n 'not __fish_seen_subcommand_from install uninstall update profile ui theme status doctor keymaps' \
  -a profile -d 'Manage per-project Neovim profiles'
complete -c nvim-config -n 'not __fish_seen_subcommand_from install uninstall update profile ui theme status doctor keymaps' \
  -a ui      -d 'Manage the active UI variant'
complete -c nvim-config -n 'not __fish_seen_subcommand_from install uninstall update profile ui theme status doctor keymaps' \
  -a theme   -d 'Manage the active colorscheme'
complete -c nvim-config -n 'not __fish_seen_subcommand_from install uninstall update profile ui theme status doctor keymaps' \
  -a status  -d 'Show current configuration summary'
complete -c nvim-config -n 'not __fish_seen_subcommand_from install uninstall update profile ui theme status doctor keymaps' \
  -a doctor  -d 'Check that required tools and binaries are installed'
complete -c nvim-config -n 'not __fish_seen_subcommand_from install uninstall update profile ui theme status doctor keymaps' \
  -a keymaps -d 'Open the keymaps reference in $PAGER'

# install subcommands
complete -c nvim-config -n '__fish_seen_subcommand_from install' -a deps    -d 'Install apt packages only'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -a config  -d 'Symlink ~/.config/nvim to this repository'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -a all     -d 'Install nvim, deps, then config'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -a tmux    -d 'Inject source-file entry into ~/.tmux.conf'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -a nvim    -d 'Install Neovim (prefers mise when present, snap otherwise)'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -a mise    -d 'Install the mise version manager (curl + GPG-verified installer)'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -a claude  -d 'Install Claude Code CLI (requires Node.js)'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -a codex   -d 'Install OpenAI Codex CLI (requires Node.js)'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -a gemini  -d 'Install Gemini CLI (requires Node.js)'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -l with-node -d 'Also install nvm and Node.js LTS'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -l snap    -d 'Force Neovim install via snap'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -l apt     -d 'Force Neovim install via apt'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -l mise    -d 'Force Neovim install via mise'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -l activate -d 'Add mise shell activation unattended, no prompt'
complete -c nvim-config -n '__fish_seen_subcommand_from install' -l no-activate -d 'Skip the mise shell-activation step, no prompt'

# uninstall subcommands
complete -c nvim-config -n '__fish_seen_subcommand_from uninstall' -a config -d 'Remove the ~/.config/nvim symlink (only if it points here)'
complete -c nvim-config -n '__fish_seen_subcommand_from uninstall' -a nvim   -d 'Remove Neovim (detects mise/snap/apt, asks for confirmation)'
complete -c nvim-config -n '__fish_seen_subcommand_from uninstall' -a mise   -d 'Remove the mise binary and its shell activation lines'
complete -c nvim-config -n '__fish_seen_subcommand_from uninstall' -a deps   -d 'Never removes apt packages; prints the manual removal command instead'
complete -c nvim-config -n '__fish_seen_subcommand_from uninstall' -a all    -d 'config, nvim, then mise (deps stays informational)'

# update subcommands
complete -c nvim-config -n '__fish_seen_subcommand_from update' -a nvim         -d 'Refresh Neovim'
complete -c nvim-config -n '__fish_seen_subcommand_from update' -a plugins      -d 'Run Lazy! sync headlessly'
complete -c nvim-config -n '__fish_seen_subcommand_from update' -a dap-adapters -d 'Install/update Mason DAP packages for active profile'
complete -c nvim-config -n '__fish_seen_subcommand_from update' -a tree-sitter -d 'Download latest tree-sitter CLI binary into vendor/'
complete -c nvim-config -n '__fish_seen_subcommand_from update' -a all          -d 'Update nvim then plugins (default)'

# profile subcommands
complete -c nvim-config -n '__fish_seen_subcommand_from profile' -a list   -d 'List available profiles (marks active with *)'
complete -c nvim-config -n '__fish_seen_subcommand_from profile' -a detect -d 'Detect profiles for the current directory'
complete -c nvim-config -n '__fish_seen_subcommand_from profile' -a set    -d 'Write .nvim-profile in the current directory'
complete -c nvim-config -n '__fish_seen_subcommand_from profile' -a unset  -d 'Remove .nvim-profile from the current directory'
complete -c nvim-config -n '__fish_seen_subcommand_from profile' -a create -d 'Generate a new profile template'
complete -c nvim-config -n '__fish_seen_subcommand_from profile' -a info   -d 'Show active profile details'

# ui subcommands
complete -c nvim-config -n '__fish_seen_subcommand_from ui' -a info  -d 'Show the active UI variant'
complete -c nvim-config -n '__fish_seen_subcommand_from ui' -a set   -d 'Write .nvim-ui at the config root'
complete -c nvim-config -n '__fish_seen_subcommand_from ui' -a unset -d 'Remove .nvim-ui (reverts to classic)'
complete -c nvim-config -n '__fish_seen_subcommand_from ui; and __fish_seen_subcommand_from set' \
  -a 'classic modern'

# theme subcommands
complete -c nvim-config -n '__fish_seen_subcommand_from theme' -a info  -d 'Show the active theme'
complete -c nvim-config -n '__fish_seen_subcommand_from theme' -a list  -d 'List all available themes'
complete -c nvim-config -n '__fish_seen_subcommand_from theme' -a set   -d 'Write .nvim-theme at the config root'
complete -c nvim-config -n '__fish_seen_subcommand_from theme' -a unset -d 'Remove .nvim-theme (reverts to nightfox)'
complete -c nvim-config -n '__fish_seen_subcommand_from theme; and __fish_seen_subcommand_from set' \
  -a '__VALID_THEMES__'
EOF
}

show_completion() {
  local shell_name="$1"
  local script
  case "${shell_name}" in
    bash) script="$(_show_completion_bash)" ;;
    zsh)  script="$(_show_completion_zsh)"  ;;
    fish) script="$(_show_completion_fish)" ;;
    *)
      printf 'Unsupported shell: %s. Supported: bash, zsh, fish\n' "${shell_name}" >&2
      return 1
      ;;
  esac
  # The three heredocs above are single-quoted (fully literal, safe against
  # premature expansion of their own $(...) completion logic), so the theme
  # list — the one genuinely dynamic piece — is injected here instead via a
  # placeholder substitution.
  printf '%s\n' "${script//__VALID_THEMES__/${VALID_THEMES[*]}}"
}

install_completion() {
  local shell_name="$1"
  local completion_dir completion_file

  case "${shell_name}" in
    bash)
      completion_dir="${HOME}/.local/share/bash-completion/completions"
      completion_file="${completion_dir}/${SCRIPT_NAME}"
      ;;
    zsh)
      completion_dir="${HOME}/.zfunc"
      completion_file="${completion_dir}/_${SCRIPT_NAME}"
      ;;
    fish)
      completion_dir="${HOME}/.config/fish/completions"
      completion_file="${completion_dir}/${SCRIPT_NAME}.fish"
      ;;
    *)
      printf 'Unsupported shell: %s. Supported: bash, zsh, fish\n' "${shell_name}" >&2
      return 1
      ;;
  esac

  mkdir -p "${completion_dir}"
  show_completion "${shell_name}" > "${completion_file}"
  log_message "INFO" "Installed ${shell_name} completion to ${completion_file}"
}

